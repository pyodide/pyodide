From 11e59ee493f4435ab88cf7d558eb1571c29d33d0 Mon Sep 17 00:00:00 2001
From: Gyeongjae Choi <gyeongjae@cloudflare.com>
Date: Tue, 24 Nov 2026 03:07:42 +0900
Subject: [PATCH 8/8] Only visit unresolved GOT entries in
 reportUndefinedSymbols

https://github.com/emscripten-core/emscripten/pull/28303

Backport of 1fb9d4e2aafe2a23ed109dc3222b82c6d81d1097 to 6.0.5, with the
`__deps` that 6.0.5 needs. The codesize test updates are left out.
---
 src/lib/libdylink.js | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/lib/libdylink.js b/src/lib/libdylink.js
index c101b2f1..e42e0b19 100644
--- a/src/lib/libdylink.js
+++ b/src/lib/libdylink.js
@@ -158,12 +158,18 @@ var LibraryDylink = {
 
   $GOT: {},
 
+  // Names of GOT entries that were created without a value (UNDEFINED_ADDR),
+  // in creation order.
+  // This avoid having to iterate the entire GOT during reportUndefinedSymbols.
+  $unresolvedSymbols__internal: true,
+  $unresolvedSymbols: 'new Set()',
+
   // Proxy handler used for GOT.mem and GOT.func imports.  Each of these
   // imports is fulfilled dynamically via the `get` method of this proxy
   // handler.  We abuse the `target` of the Proxy in order to pass the set of
   // weak imports to the handler.
   $GOTHandler__internal: true,
-  $GOTHandler__deps: ['$GOT'],
+  $GOTHandler__deps: ['$GOT', '$unresolvedSymbols'],
   $GOTHandler: {
     get(weakImports, symName) {
       var rtn = GOT[symName];
@@ -172,6 +178,7 @@ var LibraryDylink = {
         dbg(`new GOT entry: ${symName}`);
 #endif
         rtn = GOT[symName] = new WebAssembly.Global({'value': '{{{ POINTER_WASM_TYPE }}}', 'mutable': true}, {{{ UNDEFINED_ADDR }}});
+        unresolvedSymbols.add(symName);
       }
       if (!weakImports.has(symName)) {
         // Any non-weak reference to a symbol marks it as `required`, which
@@ -314,12 +321,13 @@ var LibraryDylink = {
   },
 
   $reportUndefinedSymbols__internal: true,
-  $reportUndefinedSymbols__deps: ['$GOT', '$resolveGlobalSymbol'],
+  $reportUndefinedSymbols__deps: ['$GOT', '$unresolvedSymbols', '$resolveGlobalSymbol'],
   $reportUndefinedSymbols: () => {
 #if DYLINK_DEBUG
     dbg('reportUndefinedSymbols');
 #endif
-    for (var [symName, entry] of Object.entries(GOT)) {
+    for (var symName of unresolvedSymbols) {
+      var entry = GOT[symName];
       if (entry.value == {{{ UNDEFINED_ADDR }}}) {
 #if DYLINK_DEBUG
         dbg(`undef GOT entry: ${symName}`);
@@ -331,6 +339,7 @@ var LibraryDylink = {
           dbg('ignoring undefined weak symbol:', symName);
 #endif
           entry.value = {{{ to64(0) }}};
+          unresolvedSymbols.delete(symName);
           continue;
         }
         else if (!value) {
@@ -356,6 +365,7 @@ var LibraryDylink = {
           throw new Error(`bad export type for '${symName}': ${typeof value} (${value})`);
         }
       }
+      unresolvedSymbols.delete(symName);
     }
 #if DYLINK_DEBUG
     dbg('done reportUndefinedSymbols');
-- 
